# Optional AI advice (OpenAI API key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Weather default city (optional)
VEMU_DEFAULT_CITY=Hyderabad
VEMU_VOICE_RATE=175

# Optional Outlook/Microsoft Graph app registration client ID
OUTLOOK_CLIENT_ID=

# Daily briefing time in 24-hour format. Example 08:00. Leave blank to disable auto-briefing.
VEMU_DAILY_BRIEFING_TIME=08:00

# Daily briefing provider: gmail or outlook. Leave blank to disable inbox briefing.
VEMU_EMAIL_PROVIDER=gmail
